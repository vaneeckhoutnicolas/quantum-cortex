# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# produced by `pip install -e .` (2026-09-12); never a source. A trailing comment is part of a gitignore
# pattern, so the rule as first written matched nothing (found 2026-10-03, Rev94).
*.egg-info/

# Training artefacts are never committed - the ledger record is the only trace of a run (ADR-001).
# metrics/runs.jsonl and metrics/LATEST.md ARE committed (one commit per run).
runs/
*.pt
*.bin

# Notebook and container noise
.ipynb_checkpoints/
*.sif

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# NOW-7: compiled corpora are large & reproducible from manifests — ignore them,
# but keep the manifests (the recipe) under version control
data/**/*.bin
data/*.bin
!data/mixes/
!data/mixes/*.json

# ADR-010 (the amendment of 2026-10-15, section 4 (b); the build of 2026-10-30): a resumable pass writes its progress file
# beside its output; the final file carries the progress file's sha256 and every record it holds, so the progress files
# stay with the founder like the journals and their keys (never committed). The journals, keys and archives of parts A
# and C live under runs/ (already ignored).
metrics/mqar/*.progress.jsonl
metrics/mqar/*.progress.jsonl.torn-*
metrics/mqar/*.progress.jsonl.traceback-*
